340 0 obj
<<
/Type /StructElem
/S /H1
/T (Dear Mr. President Joko Widodo,  Dear Government Representatives, )
/E (Dear Mr. President Joko Widodo,  Dear Government Representatives, )
/Pg 10 0 R
